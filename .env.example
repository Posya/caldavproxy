# Upstream (authenticated) CalDAV server. Relative calendar paths resolve here.
CALDAV_REMOTE_URL=https://caldav.example.com
CALDAV_USERNAME=user
CALDAV_PASSWORD=secret

# One or more calendar collections (same credentials). Comma / newline separated.
# Each entry may be a path or an absolute https:// URL.
# CALDAV_CALENDAR_URLS=/calendars/user/work/,/calendars/user/personal/
# CALDAV_CALENDAR_URLS=https://caldav.example.com/calendars/user/work/,https://caldav.example.com/calendars/user/personal/
#
# Legacy alias (still works): single path or comma-separated list.
# CALDAV_CALENDAR_PATH=/calendars/user/work/
#
# If neither is set, all calendars found via CalDAV discovery are fetched.

# Secret path segment that hides the public feed.
# Feed is served at /<CALDAV_SECRET_PATH>/calendar.ics
# Generate one, e.g.: openssl rand -hex 16
CALDAV_SECRET_PATH=change-me-7f3a9c2b

# Public HTTP bind address.
LISTEN_ADDR=:8080

# How often to re-read the upstream calendar.
POLL_INTERVAL=15m

# Time window for the CalDAV query and the published agenda feed.
QUERY_WINDOW_PAST=168h
QUERY_WINDOW_FUTURE=2160h

# Log level: debug | info | warn | error. Logs are written to stdout.
# debug also adds source locations and request paths.
LOG_LEVEL=info
